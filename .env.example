# Local development defaults — copy to .env and edit as needed
NODE_ENV=development
PORT=3000

# Required in production (MongoDB Atlas connection string)
MONGODB_URI=

# Required for register/login and authenticated sockets
# Use a long random string in production (Render can generate JWT_SECRET)
JWT_SECRET=change-me-to-a-long-random-secret

# First account with this email is also promoted to admin on register/login (optional)
SEED_ADMIN_EMAIL=ptvanw@gmail.com

# Browser origin for CORS / Socket.io (required in production)
# On Render, set to https://your-service.onrender.com
# If unset in production, RENDER_EXTERNAL_URL is used automatically
CLIENT_ORIGIN=http://localhost:3000

# Virtual test DJ — default for new PlatformSettings when MongoDB first connects (dev only).
# After that, toggle Bob McCluckn in Admin Panel → Platform. This env var seeds the initial DB value.
ENABLE_TEST_DJ=true

# Dev-only: POST /api/dev/queue-track is registered only when NODE_ENV is not "production"

# One-time production wipe + founder admin (run in Render Shell, then REMOVE these vars):
# CONFIRM_RESET_ALL_USERS=DELETE_ALL_USERS
# ITV_FOUNDER_PASSWORD=your-new-password-min-8-chars
# Command: node scripts/reset-all-users.js
